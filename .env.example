NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MySQL (Docker Compose)
DB_HOST=db
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change_this_local_password
DB_NAME=my_music
DB_CONNECTION_LIMIT=10

# Auth: generate a long random value; never commit the real .env
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=12h
COOKIE_SECURE=false

# Storage: local for Docker Compose; set S3_BUCKET on AWS
AWS_REGION=us-east-1
STORAGE_DRIVER=local
S3_BUCKET=
S3_SIGNED_URL_TTL=300
LOCAL_UPLOAD_DIR=storage/uploads
DB_PASSWORD_PARAMETER=/my-music/prod/app_db_password
